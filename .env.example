# Every variable is optional. Without them the site still builds and runs:
# analytics is off and the lead endpoint is a labelled stub.

# Canonical origin. Leave unset to use the default in site-url.mjs.
PUBLIC_SITE_URL=

# PostHog project API key (phc_…) and ingestion host. Used in the browser and
# by the lead endpoint's server-side conversion event.
PUBLIC_POSTHOG_KEY=
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# HubSpot form that receives leads (Forms API v3). Both must be set.
HUBSPOT_PORTAL_ID=
HUBSPOT_FORM_GUID=
