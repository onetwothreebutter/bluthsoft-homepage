---
import { privacy } from "../content/pages";
import Page from "../layouts/Page.astro";
---

<Page title={privacy.meta.title} description={privacy.meta.description}>
  <article class="page-gutter py-16 lg:py-24">
    <div class="mx-auto max-w-170">
      <h1 class="font-display text-display-md font-bold">{privacy.heading}</h1>
      <p class="mt-3 font-mono text-label text-ink/50">{privacy.updated}</p>
      <p class="mt-8 text-lede text-ink/72">{privacy.intro}</p>
      {privacy.sections.map((section) => (
        <section class="mt-10">
          <h2 class="font-display text-[24px] font-bold tracking-[-0.02em]">
            {section.heading}
          </h2>
          {section.body.map((paragraph) => (
            <p class="mt-3 text-[16px] leading-[1.6] text-ink/80">
              {paragraph}
            </p>
          ))}
        </section>
      ))}
      <a
        href={privacy.back.href}
        class="mt-12 inline-block text-[15px] font-medium underline underline-offset-4"
      >
        {privacy.back.label}
      </a>
    </div>
  </article>
</Page>
