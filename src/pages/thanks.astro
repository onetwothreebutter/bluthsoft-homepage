---
import { thanks } from "../content/pages";
import Page from "../layouts/Page.astro";

// Where a form submitted without JavaScript lands, for signups and demo
// requests alike.
---

<Page title={thanks.meta.title} description={thanks.meta.description} noindex>
  <section class="page-gutter py-24 text-center lg:py-32">
    <div class="mx-auto flex max-w-140 flex-col items-center">
      <h1 class="font-display text-display-md font-bold">{thanks.heading}</h1>
      <p class="mt-5 text-lede text-ink/72">{thanks.body}</p>
      <a
        href={thanks.back.href}
        class="mt-8 text-[15px] font-medium underline underline-offset-4"
      >
        {thanks.back.label}
      </a>
    </div>
  </section>
</Page>
