---
import { site } from "../content/site";

interface Props {
  /** What the product does, in a sentence or two. */
  description: string;
}

const { description } = Astro.props;

// Site-level structured data: who the company is and what the product is.
// Rendered on the homepage only, so it never takes its wording from a demo
// form or a privacy policy.
//
// No aggregateRating: rating markup is meant to describe reviews the page
// shows, and this page shows one testimonial, not 318 reviews.
const origin = Astro.site!.href;
const data = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    name: site.name,
    url: origin,
    description: site.description,
  },
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: site.name,
    applicationCategory: "BusinessApplication",
    operatingSystem: "Web",
    url: origin,
    description,
    offers: {
      "@type": "Offer",
      price: "0",
      priceCurrency: "USD",
      description: site.offer,
    },
  },
];
---

<script type="application/ld+json" set:html={JSON.stringify(data)} />
