---
import { header } from "../content/navigation";
import { trackCta, trackLink } from "../lib/links";
import Logo from "./Logo.astro";

/*
 * Desktop: logo, section links, Sign in and Start free.
 * Phones (below lg): logo, Start free and a menu button. The menu is a
 * popover, so it opens and closes (button, Esc) without JavaScript; the
 * script below adds the dialog-like behaviour on top.
 */

const darkButton =
  "rounded-button border border-ink bg-ink px-4.5 py-2.75 text-[15px] font-medium text-cream transition-colors hover:bg-ink/85";
const menuButton =
  "flex rounded-button border border-ink/18 p-[11.5px] transition-colors hover:bg-ink/5";
---

<header class="page-gutter">
  <div class="mx-auto flex h-16 max-w-page items-center justify-between lg:h-18">
    <a href="/" class="rounded-button">
      <Logo name={header.brand} />
    </a>

    <nav
      aria-label={header.navLabel}
      class="hidden items-center gap-10 lg:flex"
    >
      <ul class="flex items-center gap-7 text-[15px] text-ink/72">
        {header.links.map((link) => (
          <li>
            <a
              href={link.href}
              class="transition-colors hover:text-ink"
              {...trackLink(link.href, "nav")}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="flex items-center gap-3.5">
        <a
          href={header.signIn.href}
          class="text-[15px] text-ink/72 transition-colors hover:text-ink"
          {...trackLink(header.signIn.href, "nav")}
        >
          {header.signIn.label}
        </a>
        <a href={header.cta.href} class={darkButton} {...trackCta("nav")}>
          {header.cta.label}
        </a>
      </div>
    </nav>

    <div class="flex items-center gap-2.5 lg:hidden">
      <a href={header.cta.href} class={darkButton} {...trackCta("nav")}>
        {header.cta.label}
      </a>
      <button
        type="button"
        popovertarget="site-menu"
        aria-label={header.openMenu}
        class={menuButton}
      >
        <img src="/images/icon-menu.svg" width="20" height="20" alt="" />
      </button>
    </div>
  </div>
</header>

<div
  id="site-menu"
  popover
  class="m-0 size-full max-h-none max-w-none overflow-y-auto border-0 bg-cream p-0 text-ink lg:hidden"
>
  <div class="page-gutter flex h-16 items-center justify-between">
    <a href="/" class="rounded-button">
      <Logo name={header.brand} />
    </a>
    <div class="flex items-center gap-2.5">
      <a href={header.cta.href} class={darkButton} {...trackCta("menu")}>
        {header.cta.label}
      </a>
      <button
        type="button"
        popovertarget="site-menu"
        popovertargetaction="hide"
        aria-label={header.closeMenu}
        class={menuButton}
        autofocus
      >
        <img src="/images/icon-close.svg" width="20" height="20" alt="" />
      </button>
    </div>
  </div>
  <nav aria-label={header.navLabel} class="page-gutter pt-2 pb-6">
    <ul>
      {header.links.map((link) => (
        <li>
          <a
            href={link.href}
            class="block border-b border-ink/10 py-4.5 text-[20px] font-medium"
            {...trackLink(link.href, "menu")}
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <a
      href={header.signIn.href}
      class="mt-5 inline-block text-[17px] font-medium text-ink/72"
      {...trackLink(header.signIn.href, "menu")}
    >
      {header.signIn.label}
    </a>
    <a
      href={header.cta.href}
      class="mt-5 flex justify-center rounded-button border border-ink bg-ink px-4.5 py-3.75 text-[15px] font-medium text-cream"
      {...trackCta("menu")}
    >
      {header.cta.label}
    </a>
    <p class="mt-3 text-center text-[13px] text-ink/60">{header.menuNote}</p>
  </nav>
</div>

<script>
  const menu = document.getElementById("site-menu");

  if (menu) {
    // The open menu covers the whole page, so treat it like a dialog: what's
    // behind it can't be reached by keyboard or screen reader either.
    menu.addEventListener("toggle", (event) => {
      const open = (event as ToggleEvent).newState === "open";
      for (const element of document.body.children)
        if (element !== menu && element instanceof HTMLElement)
          element.inert = open;
    });

    // Choosing a link closes the menu. Most are in-page anchors, so the page
    // would otherwise scroll behind a menu that's still open.
    menu.addEventListener("click", (event) => {
      if ((event.target as Element).closest("a")) menu.hidePopover();
    });

    // Widening into the desktop layout hides the menu's close button.
    matchMedia("(width >= 64rem)").addEventListener("change", (event) => {
      if (event.matches) menu.hidePopover();
    });
  }
</script>
