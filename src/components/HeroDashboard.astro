---
import { home } from "../content/home";
import { splitWords } from "../lib/words";

/*
 * The hero's product card: a drawing, not an interface. Screen readers get
 * one summary (role="img"); nothing inside is focusable. The floating
 * "Restock created" notice only shows beside the two-column desktop layout.
 *
 * The card sizes its insides by its own width (a container query), not the
 * viewport's: under 512px wide it uses the mobile frame's tighter padding and
 * smaller numbers, which is a phone, or the narrower two-column layout
 * between 1024 and about 1280px.
 *
 * When the card comes into view, the three stats rise into place one after
 * another, then the chart's bars grow up from the baseline, left to right,
 * then Bluth AI "thinks", its reply streams in word by word, and its
 * suggested actions follow. Then, where the restock notice shows, the first
 * action is "clicked" and the notice pops in. The timing is in global.css;
 * the script below holds it until the card is in view. Still when the visitor
 * asks for reduced motion.
 */

const { dashboard } = home.hero;

// Bluth AI's reply word by word, so the words can stream in one after another
// like a reply being generated. The count times the steps after the reply.
const { message } = dashboard.assistant;
const toWords = (text: string, emphasis = false) =>
  splitWords(text).map((word) => ({ word, emphasis }));
const reply = [
  ...toWords(message.before),
  ...toWords(message.emphasis, true),
  ...toWords(message.after),
];

const toneClass = {
  up: "text-healthy",
  neutral: "text-ink/55",
  warning: "text-reorder",
} as const;

const barClass = {
  sold: "bg-ink/10",
  peak: "bg-banana",
  now: "border border-ink bg-banana",
  forecast: "bg-ink/16",
} as const;
---

<div
  role="img"
  aria-label={dashboard.summary}
  class="@container relative"
  style={`--reply-words: ${reply.length}`}
>
  <div
    aria-hidden="true"
    class="overflow-hidden rounded-card border border-ink/14 bg-white shadow-card"
  >
    <div class="flex items-center gap-2.5 px-4.5 py-3.5">
      <span class="size-5.5 shrink-0 rounded-[7px] border border-ink bg-banana"></span>
      <p class="min-w-0 flex-1 text-[13.5px] font-semibold">
        {dashboard.title}
      </p>
      <p class="shrink-0 font-mono text-[11.5px] text-ink/55">
        {dashboard.status}
      </p>
    </div>
    <div class="h-px bg-ink/10"></div>

    <div class="px-3.5 py-4 @lg:p-5">
      <p class="font-mono text-label text-ink/50">{dashboard.label}</p>

      <div class="mt-3 flex gap-2 @lg:gap-3">
        {dashboard.stats.map((stat, index) => (
          <div
            class="flex min-w-0 flex-1 flex-col gap-0.5 rounded-tile border border-ink/10 bg-cream px-2.5 py-3 motion-safe:animate-rise-in @lg:p-3.5"
            style={`--stagger: ${index}`}
          >
            <p class="font-display text-[22px] font-semibold tracking-[-0.03em] @lg:text-[30px]">
              {stat.value}
            </p>
            <p class="text-[11.5px] text-ink/60 @lg:text-[12.5px]">
              {stat.label}
            </p>
            <p
              class:list={[
                "mt-1.5 text-[11.5px] @lg:text-[12px]",
                toneClass[stat.tone],
              ]}
            >
              {stat.note}
            </p>
          </div>
        ))}
      </div>

      <div class="mt-5 flex h-24 items-end gap-1 @lg:gap-[7px]">
        {dashboard.chart.map((bar, index) => (
          <div
            class:list={[
              "flex-1 origin-bottom rounded-t-[5px] motion-safe:animate-grow-up",
              barClass[bar.kind],
            ]}
            style={`height: ${bar.height}px; --stagger: ${index}`}
          />
        ))}
      </div>
      <div class="mt-[7px] flex justify-between font-mono text-[10.5px] text-ink/45">
        {dashboard.axis.map((tick) => (
          <span>{tick}</span>
        ))}
      </div>

      <div class="mt-4.5 rounded-panel bg-forest p-3.5 text-cream @lg:px-4.5 @lg:py-4">
        <div class="flex items-center gap-2">
          <span class="size-4.5 rounded-[6px] bg-banana"></span>
          <p class="font-mono text-label text-cream/75">
            {dashboard.assistant.label}
          </p>
        </div>
        <p class="relative mt-2.5 text-[16px] leading-[1.45]">
          <span class="absolute top-0 left-0 hidden h-lh items-center gap-1 motion-safe:flex motion-safe:animate-thinking">
            {[0, 1, 2].map((index) => (
              <span
                class="size-1.5 rounded-full bg-cream motion-safe:animate-thinking-dot"
                style={`--stagger: ${index}`}
              />
            ))}
          </span>
          {reply.map(({ word, emphasis }, index) => (
            <span
              class:list={[
                "motion-safe:animate-stream-in",
                emphasis && "font-semibold text-banana",
              ]}
              style={`--stagger: ${index}`}
            >
              {word}
            </span>
          ))}
        </p>
        <div class="mt-3.5 flex flex-wrap items-center gap-2.5">
          <span
            class="motion-safe:animate-rise-in-after-reply"
            style="--stagger: 0"
          >
            <span class="block rounded-[11px] border border-ink bg-banana px-3.5 py-[9px] text-[13.5px] font-semibold text-ink xl:motion-safe:animate-press">
              {dashboard.assistant.actions[0]}
            </span>
          </span>
          <span
            class="rounded-[11px] border border-cream/28 px-3.5 py-[9px] text-[13.5px] text-cream/80 motion-safe:animate-rise-in-after-reply"
            style="--stagger: 1"
          >
            {dashboard.assistant.actions[1]}
          </span>
          <span
            class="font-mono text-[11px] text-cream/50 motion-safe:animate-rise-in-after-reply @lg:ml-2.5"
            style="--stagger: 2"
          >
            {dashboard.assistant.confidence}
          </span>
        </div>
      </div>
    </div>
  </div>

  <div
    aria-hidden="true"
    class="absolute top-[490px] -left-8.5 hidden items-center gap-2.5 rounded-tile border border-ink/14 bg-white px-3.5 py-3 shadow-float motion-safe:animate-pop-in xl:flex"
  >
    <span class="size-6.5 rounded-chip bg-forest"></span>
    <div class="flex flex-col gap-px">
      <p class="text-[12.5px] font-semibold">{dashboard.toast.title}</p>
      <p class="font-mono text-[10.5px] text-ink/55">
        {dashboard.toast.detail}
      </p>
    </div>
  </div>
</div>

<script is:inline>
  // Hold the card's animations until it's in view: on phones it sits below
  // the email form, and the sequence would be over before anyone got there.
  // data-motion="waiting" pauses them (global.css) until the card's top
  // passes 70% of the way down the screen, which on desktop it already has
  // at load. Inline, so the hold is on before they start; without JavaScript
  // they play on load. The observer is made first so that if it can't be,
  // the card is never held.
  (() => {
    const card = document.currentScript.previousElementSibling;
    const observer = new IntersectionObserver(
      ([entry]) => {
        if (!entry.isIntersecting) return;
        delete card.dataset.motion;
        observer.disconnect();
      },
      { rootMargin: "0px 0px -30% 0px" },
    );
    observer.observe(card);
    card.dataset.motion = "waiting";
  })();
</script>
