---
import { home } from "../content/home";

/*
 * The hero's product card: a drawing, not an interface. Screen readers get
 * one summary (role="img"); nothing inside is focusable. The floating
 * "Restock created" notice only shows beside the two-column desktop layout.
 *
 * The card sizes its insides by its own width (a container query), not the
 * viewport's: under 512px wide it uses the mobile frame's tighter padding and
 * smaller numbers, which is a phone, or the narrower two-column layout
 * between 1024 and about 1280px.
 */

const { dashboard } = home.hero;

const toneClass = {
  up: "text-healthy",
  neutral: "text-ink/55",
  warning: "text-reorder",
} as const;

const barClass = {
  sold: "bg-ink/10",
  peak: "bg-banana",
  now: "border border-ink bg-banana",
  forecast: "bg-ink/16",
} as const;
---

<div role="img" aria-label={dashboard.summary} class="@container relative">
  <div
    aria-hidden="true"
    class="overflow-hidden rounded-card border border-ink/14 bg-white shadow-card"
  >
    <div class="flex items-center gap-2.5 px-4.5 py-3.5">
      <span class="size-5.5 shrink-0 rounded-[7px] border border-ink bg-banana"></span>
      <p class="min-w-0 flex-1 text-[13.5px] font-semibold">
        {dashboard.title}
      </p>
      <p class="shrink-0 font-mono text-[11.5px] text-ink/55">
        {dashboard.status}
      </p>
    </div>
    <div class="h-px bg-ink/10"></div>

    <div class="px-3.5 py-4 @lg:p-5">
      <p class="font-mono text-label text-ink/50">{dashboard.label}</p>

      <div class="mt-3 flex gap-2 @lg:gap-3">
        {dashboard.stats.map((stat) => (
          <div class="flex min-w-0 flex-1 flex-col gap-0.5 rounded-tile border border-ink/10 bg-cream px-2.5 py-3 @lg:p-3.5">
            <p class="font-display text-[22px] font-semibold tracking-[-0.03em] @lg:text-[30px]">
              {stat.value}
            </p>
            <p class="text-[11.5px] text-ink/60 @lg:text-[12.5px]">
              {stat.label}
            </p>
            <p
              class:list={[
                "mt-1.5 text-[11.5px] @lg:text-[12px]",
                toneClass[stat.tone],
              ]}
            >
              {stat.note}
            </p>
          </div>
        ))}
      </div>

      <div class="mt-5 flex h-24 items-end gap-1 @lg:gap-[7px]">
        {dashboard.chart.map((bar) => (
          <div
            class:list={["flex-1 rounded-t-[5px]", barClass[bar.kind]]}
            style={`height: ${bar.height}px`}
          />
        ))}
      </div>
      <div class="mt-[7px] flex justify-between font-mono text-[10.5px] text-ink/45">
        {dashboard.axis.map((tick) => (
          <span>{tick}</span>
        ))}
      </div>

      <div class="mt-4.5 rounded-panel bg-forest p-3.5 text-cream @lg:px-4.5 @lg:py-4">
        <div class="flex items-center gap-2">
          <span class="size-4.5 rounded-[6px] bg-banana"></span>
          <p class="font-mono text-label text-cream/75">
            {dashboard.assistant.label}
          </p>
        </div>
        <p class="mt-2.5 text-[16px] leading-[1.45]">
          {dashboard.assistant.message.before}
          <span class="font-semibold text-banana">
            {dashboard.assistant.message.emphasis}
          </span>
          {dashboard.assistant.message.after}
        </p>
        <div class="mt-3.5 flex flex-wrap items-center gap-2.5">
          <span class="rounded-[11px] border border-ink bg-banana px-3.5 py-[9px] text-[13.5px] font-semibold text-ink">
            {dashboard.assistant.actions[0]}
          </span>
          <span class="rounded-[11px] border border-cream/28 px-3.5 py-[9px] text-[13.5px] text-cream/80">
            {dashboard.assistant.actions[1]}
          </span>
          <span class="font-mono text-[11px] text-cream/50 @lg:ml-2.5">
            {dashboard.assistant.confidence}
          </span>
        </div>
      </div>
    </div>
  </div>

  <div
    aria-hidden="true"
    class="absolute top-[490px] -left-8.5 hidden items-center gap-2.5 rounded-tile border border-ink/14 bg-white px-3.5 py-3 shadow-float xl:flex"
  >
    <span class="size-6.5 rounded-chip bg-forest"></span>
    <div class="flex flex-col gap-px">
      <p class="text-[12.5px] font-semibold">{dashboard.toast.title}</p>
      <p class="font-mono text-[10.5px] text-ink/55">
        {dashboard.toast.detail}
      </p>
    </div>
  </div>
</div>
