---
import { home } from "../content/home";
import ProductPanel from "./ProductPanel.astro";

// "One platform": the heading, then a card of tabs. The tabs are real
// controls (src/lib/tabs.ts); what's inside each panel is a drawing plus
// real text. Choosing a tab, by click or by key, records `Tab Selected`
// through the page-level listener.

const { product } = home;
---

<section id="product" data-section="product" class="page-gutter py-16 lg:py-28">
  <div class="mx-auto max-w-page">
    <div class="max-w-165">
      <p class="font-mono text-label text-ink/50">{product.eyebrow}</p>
      <h2 class="mt-3.5 font-display text-display-md font-bold">
        {product.heading}
      </h2>
      <p class="mt-4.5 text-[16px] leading-[1.55] text-ink/72 lg:text-[18px]">
        {product.lede}
      </p>
    </div>

    <div class="mt-7 overflow-hidden rounded-card-lg border border-ink/14 bg-white lg:mt-11">
      <div class="flex items-center gap-1 bg-cream px-3 py-2.5">
        <div
          role="tablist"
          aria-label={product.tabsLabel}
          data-tabs
          class="flex gap-1"
        >
          {product.panels.map((panel, i) => (
            <button
              type="button"
              role="tab"
              id={`product-tab-${i}`}
              aria-controls={`product-panel-${i}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? 0 : -1}
              data-location="product"
              class="rounded-[11px] px-4 py-2.5 text-[14.5px] font-medium whitespace-nowrap text-ink/68 transition-colors hover:text-ink aria-selected:bg-ink aria-selected:text-cream"
            >
              {panel.tab}
            </button>
          ))}
        </div>
        <p class="ml-auto hidden font-mono text-[11px] text-ink/45 md:block">
          {product.syncStatus}
        </p>
      </div>
      <div class="h-px bg-ink/10"></div>
      {product.panels.map((panel, i) => (
        <div
          role="tabpanel"
          id={`product-panel-${i}`}
          aria-labelledby={`product-tab-${i}`}
          hidden={i !== 0}
          tabindex="0"
          class="rounded-b-card-lg focus-visible:-outline-offset-2 lg:grid lg:grid-cols-[768fr_512fr]"
        >
          <ProductPanel panel={panel} />
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import { bindTabs } from "../lib/tabs";

  for (const tablist of document.querySelectorAll<HTMLElement>("[data-tabs]"))
    bindTabs(tablist);
</script>
