---
import { footer } from "../content/navigation";
import { trackLink } from "../lib/links";
import Logo from "./Logo.astro";

/*
 * Desktop: the brand and three link columns in one row, then a bottom bar.
 * Phones: the brand on its own row, the columns two to a row (155px each, as
 * drawn), and the bottom bar wrapping.
 */
---

<footer
  data-section="footer"
  class="page-gutter bg-ink pt-12 pb-8 text-cream lg:pt-16 lg:pb-10"
>
  <div class="mx-auto flex max-w-page flex-col gap-9 lg:gap-12">
    <div class="flex flex-wrap gap-x-6 gap-y-8 lg:flex-nowrap lg:gap-10">
      <div class="w-full lg:w-auto lg:flex-1">
        <Logo name={footer.brand} tone="cream" />
        <p class="mt-4 max-w-70 text-[14.5px] leading-[1.6] text-cream/72">
          {footer.tagline}
        </p>
      </div>
      {footer.columns.map((column) => (
        <nav
          aria-labelledby={`footer-${column.heading.toLowerCase()}`}
          class="w-38.75 lg:w-auto lg:flex-1"
        >
          <h2
            id={`footer-${column.heading.toLowerCase()}`}
            class="font-mono text-[10.5px] tracking-[0.09em] text-cream/45"
          >
            {column.heading}
          </h2>
          <ul class="mt-3.5 flex flex-col gap-[11px] text-[14.5px] text-cream/78">
            {column.links.map((link) => (
              <li>
                <a
                  href={link.href}
                  class="transition-colors hover:text-cream"
                  {...trackLink(link.href, "footer")}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>

    <div class="flex flex-wrap items-center gap-x-4 gap-y-2.5 border-t border-cream/14 pt-6 font-mono text-[11.5px] text-cream/50 lg:gap-x-5">
      <p>{footer.copyright}</p>
      {footer.legal.map((link) => (
        <a
          href={link.href}
          class="transition-colors hover:text-cream"
          {...trackLink(link.href, "footer")}
        >
          {link.label}
        </a>
      ))}
      <p class="lg:ml-auto">{footer.motto}</p>
    </div>
  </div>
</footer>
