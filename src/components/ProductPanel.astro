---
import type { ProductPanel, Tone } from "../content/home";

/*
 * One tab's contents: a table drawn as a product screen (one role="img" with
 * a spoken summary) beside "Why it matters", which is real text.
 *
 * Column widths are the desktop frame's (200 : 120 : 105 : 168). On phones
 * only the first middle column shows, at the mobile frame's fixed widths.
 */
interface Props {
  panel: ProductPanel;
}

const { panel } = Astro.props;
const [itemLabel, ...rest] = panel.columns;
const middleLabels = rest.slice(0, -1);
const statusLabel = rest.at(-1);

const middle = [
  "w-15 shrink-0 lg:w-auto lg:flex-[120_1_0]",
  "hidden lg:block lg:flex-[105_1_0]",
];
const cell = {
  item: "min-w-0 flex-[200_1_0]",
  status: "w-24 shrink-0 lg:w-auto lg:flex-[168_1_0]",
};
const tone: Record<Tone, string> = {
  ok: "bg-healthy-bg text-healthy",
  warning: "bg-below-par-bg text-below-par",
  alert: "bg-reorder-bg text-reorder",
};
---

<div class="border-ink/10 px-4 py-5 lg:border-r lg:px-7 lg:py-6.5">
  <div role="img" aria-label={panel.summary}>
    <div aria-hidden="true">
      <div class="flex flex-wrap items-baseline gap-x-3">
        <p class="font-display text-[22px] font-semibold tracking-[-0.02em]">
          {panel.title}
        </p>
        <p class="text-[13px] text-ink/55">{panel.meta}</p>
      </div>
      <div class="mt-3.5 flex gap-3 border-b border-ink/10 pt-3.5 pb-2.5 font-mono text-[10.5px] tracking-[0.07em] text-ink/50">
        <span class={cell.item}>{itemLabel}</span>
        {middleLabels.map((label, i) => (
          <span class={middle[i]}>{label}</span>
        ))}
        <span class={cell.status}>{statusLabel}</span>
      </div>
      {panel.rows.map((row) => (
        <div class="flex items-center gap-3 border-b border-ink/7 py-3.25">
          <span class:list={[cell.item, "text-[14.5px] font-medium"]}>
            {row.item}
          </span>
          {row.values.map((value, i) => (
            <span
              class:list={[
                middle[i],
                "font-mono text-[13.5px]",
                i > 0 && "text-ink/50",
              ]}
            >
              {value}
            </span>
          ))}
          <span class={cell.status}>
            <span
              class:list={[
                "inline-block rounded-full px-2.5 py-1 text-[12px] font-medium whitespace-nowrap",
                tone[row.status.tone],
              ]}
            >
              {row.status.label}
            </span>
          </span>
        </div>
      ))}
      <span class="mt-4.5 inline-block rounded-button border border-ink bg-ink px-4 py-2.75 text-[14px] font-medium text-cream">
        {panel.action}
      </span>
    </div>
  </div>
</div>

<div class="bg-cream px-4 py-5 lg:px-7 lg:py-6.5">
  <p class="font-mono text-label text-ink/50">{panel.why.label}</p>
  <h3 class="mt-3 font-display text-[20px] font-semibold tracking-[-0.02em]">
    {panel.why.heading}
  </h3>
  <p class="mt-2.5 text-[15px] leading-[1.55] text-ink/72">{panel.why.body}</p>
  <dl class="mt-5.5 flex flex-col gap-4 border-t border-ink/10 pt-5.5">
    {panel.why.stats.map((stat) => (
      <div class="flex flex-col-reverse gap-0.5">
        <dt class="text-[13px] text-ink/60">{stat.label}</dt>
        <dd class="font-display text-[28px] font-semibold tracking-[-0.03em]">
          {stat.value}
        </dd>
      </div>
    ))}
  </dl>
</div>
