---
import { home } from "../content/home";
import { trackCta } from "../lib/links";

// "It notices. Then it handles it." on forest. The rule card is a drawing:
// one role="img" with a spoken summary, nothing focusable inside (so "View
// run history" is drawn, not linked). Side by side from lg, stacked on phones.

const { automation } = home;
const { rule } = automation;

// The first step's icon is lit, finished steps are dim, waiting ones dimmer,
// as drawn.
const iconClass = (index: number, status: string) =>
  index === 0
    ? "bg-banana"
    : status === "Waiting"
      ? "bg-cream/10"
      : "bg-cream/18";
---

<section
  id="automation"
  data-section="automation"
  class="page-gutter bg-forest py-16 text-cream lg:py-28"
>
  <div class="mx-auto grid max-w-page gap-10 lg:grid-cols-[minmax(0,512fr)_minmax(0,704fr)] lg:items-start lg:gap-16">
    <div>
      <p class="font-mono text-label text-banana/90">{automation.eyebrow}</p>
      <h2 class="mt-3.5 font-display text-display-md font-bold">
        {automation.heading}
      </h2>
      <p class="mt-4.5 text-[16px] leading-[1.55] text-cream/78 lg:text-[18px]">
        {automation.lede}
      </p>
      <ul class="mt-8 flex flex-col gap-3.5">
        {automation.bullets.map((bullet) => (
          <li class="flex items-start gap-3 text-[15.5px] text-cream/82">
            <img
              src="/images/bullet.svg"
              width="6"
              height="14"
              alt=""
              class="shrink-0"
            />
            {bullet}
          </li>
        ))}
      </ul>
      <a
        href={automation.cta.href}
        class="mt-8.5 inline-block rounded-tile border border-ink bg-banana px-6 py-3.75 text-[16px] font-semibold text-ink shadow-press transition active:translate-y-[3px] active:shadow-none"
        {...trackCta("automation")}
      >
        {automation.cta.label}
      </a>
    </div>

    <div
      role="img"
      aria-label={rule.summary}
      class="rounded-card-lg border border-cream/17 bg-cream/5 p-4 lg:p-6.5"
    >
      <div aria-hidden="true">
        <div class="flex items-center justify-between gap-3">
          <p class="font-mono text-label text-cream/60">{rule.label}</p>
          <span class="rounded-full bg-healthy-on-dark-bg px-2.5 py-1 text-[12px] font-medium text-healthy-on-dark">
            {rule.status}
          </span>
        </div>

        <div class="mt-4.5 flex flex-col gap-2 rounded-panel bg-cream px-3.5 py-4 text-ink lg:px-4.5">
          <p class="font-mono text-[10.5px] tracking-[0.09em] text-ink/50">
            {rule.when.label}
          </p>
          <div class="flex flex-wrap items-center gap-x-2.5 gap-y-2">
            <span class="text-[16px] font-semibold">{rule.when.subject}</span>
            <span class="rounded-chip border border-ink/12 bg-sand px-2.25 py-1.25 font-mono text-[13px]">
              {rule.when.operator}
            </span>
            <span class="rounded-chip border border-ink bg-banana px-2.25 py-1.25 font-mono text-[13px]">
              {rule.when.value}
            </span>
          </div>
        </div>

        <ol class="mt-3.5 flex flex-col gap-2.5">
          {rule.steps.map((step, index) => (
            <li class="flex items-center gap-2.5 rounded-tile border border-cream/14 bg-cream/6 px-3 py-3.5 lg:gap-3.5 lg:px-4">
              <span class="w-5 shrink-0 font-mono text-[11.5px] text-banana/90 lg:w-5.5">
                {step.number}
              </span>
              <span
                class:list={[
                  "size-7.5 shrink-0 rounded-[10px] border border-cream/20",
                  iconClass(index, step.status),
                ]}
              />
              <span class="flex min-w-0 flex-1 flex-col gap-0.5">
                <span class="text-[15px] font-medium">{step.title}</span>
                <span class="font-mono text-[11.5px] text-cream/55">
                  {step.detail}
                </span>
              </span>
              <span
                class:list={[
                  "shrink-0 text-[12px]",
                  step.status === "Waiting"
                    ? "text-cream/55"
                    : "text-healthy-on-dark",
                ]}
              >
                {step.status}
              </span>
            </li>
          ))}
        </ol>

        <div class="mt-4.5 flex items-center justify-between gap-3 border-t border-cream/14 pt-4">
          <span class="font-mono text-[11px] text-cream/50">
            {rule.lastRun}
          </span>
          <span class="text-[13.5px] text-banana">{rule.history}</span>
        </div>
      </div>
    </div>
  </div>
</section>
