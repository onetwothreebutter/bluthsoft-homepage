---
import { home } from "../content/home";
import { trackCta } from "../lib/links";
import HeroDashboard from "./HeroDashboard.astro";
import Honeypot from "./Honeypot.astro";

/*
 * The column's spacing is the frame's: 22px between items, and 56px above
 * the form and above the rating (the frame's 12px spacers plus two gaps).
 *
 * Two columns from lg (1024px) up, as in the desktop frame. Below that the
 * copy stacks over the product card, as in the mobile frame: the email form
 * stays in the first screen and the card follows it.
 *
 * The email form posts straight to the lead endpoint, so it works without
 * JavaScript; src/lib/lead-form.ts adds the analytics ID and campaign tags.
 */

const { hero } = home;
---

<section
  data-section="hero"
  class="page-gutter pt-8 pb-14 md:pt-16 md:pb-20 lg:pt-24 lg:pb-26"
>
  <div class="mx-auto grid max-w-page gap-10 lg:grid-cols-[minmax(0,566fr)_minmax(0,650fr)] lg:items-center xl:gap-16">
    <div class="flex max-w-141.5 flex-col items-start gap-5.5">
      <p class="flex items-center gap-[9px] rounded-full border border-ink/12 bg-white py-1.5 pr-3 pl-2 text-[13px] font-medium tracking-[0.01em]">
        <img src="/images/status-dot.svg" width="7" height="7" alt="" />
        {hero.eyebrow}
      </p>

      <h1 class="font-display text-display-xl font-bold">{hero.heading}</h1>

      <p class="max-w-117.5 text-lede text-ink/72">{hero.lede}</p>

      <form
        method="post"
        action="/api/lead"
        data-lead-form="hero"
        class="relative mt-8.5 flex w-full max-w-120 items-center gap-2.5 rounded-panel border border-ink/18 bg-white p-2 shadow-field focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-ink"
      >
        <label for="hero-email" class="sr-only">
          {hero.form.label}
        </label>
        <input
          id="hero-email"
          type="email"
          name="email"
          required
          autocomplete="email"
          placeholder={hero.form.placeholder}
          class="min-w-0 flex-1 bg-transparent p-3 text-[16px] placeholder:text-ink/45 focus:outline-none"
        />
        <input type="hidden" name="intent" value="signup" />
        <input type="hidden" name="source" value="hero" />
        <Honeypot />
        <button
          type="submit"
          class="shrink-0 rounded-button border border-ink bg-banana px-5 py-3.25 text-[15.5px] font-semibold shadow-press transition active:translate-y-[3px] active:shadow-none"
        >
          {hero.form.submit}
        </button>
      </form>

      <div class="flex flex-wrap items-center gap-x-3.5 gap-y-2">
        <p class="text-[13px] text-ink/60">{hero.note}</p>
        <a
          href={hero.secondary.href}
          class="text-[13.5px] font-medium underline-offset-4 hover:underline"
          {...trackCta("hero")}
        >
          {hero.secondary.label}
        </a>
      </div>

      <div class="mt-8.5 flex flex-wrap items-center gap-x-3.5 gap-y-2 text-[13.5px] text-ink/62">
        <img src="/images/stars.svg" width="97" height="17" alt="" />
        <p class="text-[14px] font-semibold text-ink">{hero.rating.score}</p>
        <p>{hero.rating.source}</p>
        <span
          aria-hidden="true"
          class="hidden h-3.5 w-px bg-ink/14 md:max-lg:block xl:block"
        ></span>
        <p>{hero.rating.aside}</p>
      </div>
    </div>

    <div class="w-full max-w-162.5">
      <HeroDashboard />
    </div>
  </div>
</section>
