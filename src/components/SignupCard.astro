---
/**
 * The "Get started" card from the conversion frames: the pitch and a
 * checklist on sand, the form on white. Side by side from lg, stacked on
 * phones. The setup questions and /demo both use it.
 */
interface Props {
  eyebrow: string;
  heading: string;
  lede: string;
  checklist: readonly string[];
  /** h2 inside the homepage, h1 when the card is the page (/demo). */
  headingLevel?: "h1" | "h2";
}

const {
  eyebrow,
  heading,
  lede,
  checklist,
  headingLevel: Heading = "h2",
} = Astro.props;
---

<div class="overflow-hidden rounded-section border border-ink/12 bg-sand lg:flex">
  <div class="px-5 pt-8 pb-7 lg:flex-1 lg:px-12 lg:py-14">
    <p class="font-mono text-label text-ink/50">{eyebrow}</p>
    <Heading class="mt-3.5 font-display text-display-sm font-bold max-lg:text-[32px]">
      {heading}
    </Heading>
    <p class="mt-4 max-w-105 text-[16px] leading-[1.55] text-ink/72 lg:text-[17px]">
      {lede}
    </p>
    <ul class="mt-8.5 flex flex-col gap-3.5">
      {checklist.map((item) => (
        <li class="flex items-center gap-[11px] text-[15px]">
          <span
            aria-hidden="true"
            class="size-5 shrink-0 rounded-[7px] border border-ink bg-banana"
          />
          {item}
        </li>
      ))}
    </ul>
  </div>
  <div class="border-t border-ink/12 bg-white px-5 py-6 lg:flex-1 lg:border-t-0 lg:border-l lg:p-10">
    <slot />
  </div>
</div>
