---
import { home } from "../content/home";

// Rating and press, four metrics, then the testimonial beside a receipt.
// The receipt is a drawing (role="img") and only shows from lg, as in the
// mobile frame. The metric bars are decoration, kept as designed (they
// measure nothing; see DECISIONS.md).

const { proof } = home;
const { receipt } = proof;
const rule = "block h-px w-full";
---

<section
  id="customers"
  data-section="proof"
  aria-labelledby="proof-heading"
  class="page-gutter py-16 lg:py-28"
>
  <div class="mx-auto max-w-page">
    <h2 id="proof-heading" class="sr-only">
      {proof.label}
    </h2>

    <div class="flex flex-col items-start gap-3.5 pb-7 lg:flex-row lg:items-center lg:gap-5 lg:pb-9">
      <p class="flex items-center gap-3 rounded-full border border-ink/12 bg-white py-2.25 pr-4.5 pl-3.5">
        <img src="/images/stars-sm.svg" width="92" height="16" alt="" />
        <span class="text-[14.5px] font-semibold">{proof.rating.score}</span>
        <span class="text-[13.5px] text-ink/60">{proof.rating.count}</span>
      </p>
      <ul class="flex flex-wrap gap-x-4 gap-y-2 font-mono text-[11px] tracking-[0.08em] text-ink/45 lg:gap-x-5.5">
        {proof.press.map((name) => (
          <li>{name}</li>
        ))}
      </ul>
    </div>

    <ul class="grid grid-cols-2 gap-x-4 gap-y-7 border-b border-ink/10 pb-10 lg:grid-cols-4 lg:gap-6 lg:pb-14">
      {proof.metrics.map((metric) => (
        <li>
          <p class="font-display text-display-sm leading-[normal] font-bold tracking-[-0.035em]">
            {metric.value}
          </p>
          <p class="mt-1 text-[13px] text-ink/62 lg:text-[14px]">
            {metric.label}
          </p>
          <div
            aria-hidden="true"
            class="mt-3.5 h-[3px] overflow-hidden rounded-full bg-ink/10"
          >
            <div
              class="h-full bg-banana"
              style={`width: ${metric.fill * 100}%`}
            />
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-10 flex gap-14 lg:mt-14">
      <figure class="min-w-0 flex-1">
        <blockquote class="font-display text-quote font-semibold">
          <p>{proof.testimonial.quote}</p>
        </blockquote>
        <figcaption class="mt-6.5 flex items-center gap-3.5">
          <span
            aria-hidden="true"
            class="flex size-11 shrink-0 items-center justify-center rounded-tile border border-ink/14 bg-sand font-mono text-[13px] font-semibold"
          >
            {proof.testimonial.initials}
          </span>
          <span class="flex flex-col gap-0.5">
            <span class="text-[15px] font-semibold">
              {proof.testimonial.name}
            </span>
            <span class="text-[13.5px] text-ink/60">
              {proof.testimonial.role}
            </span>
          </span>
        </figcaption>
        <ul class="mt-8.5 flex flex-wrap gap-2.5">
          {[...proof.testimonial.locations, proof.testimonial.more].map(
            (place) => (
              <li class="rounded-full border border-ink/12 bg-white px-3.25 py-1.75 text-[13px]">
                {place}
              </li>
            ),
          )}
        </ul>
      </figure>

      <div
        role="img"
        aria-label={receipt.summary}
        class="hidden min-w-0 flex-1 self-start rounded-[6px] border border-ink/14 bg-white px-5.5 pt-6 pb-8.5 shadow-receipt lg:block"
      >
        <div aria-hidden="true" class="font-mono">
          <p class="text-center text-[12.5px] tracking-[0.14em]">
            {receipt.store}
          </p>
          <p class="mt-1 text-center text-[10.5px] text-ink/55">
            {receipt.terminal}
          </p>
          <img
            src="/images/receipt-rule.svg"
            alt=""
            class:list={[rule, "my-4"]}
          />
          <div class="flex flex-col gap-[9px] text-[12px]">
            {receipt.lines.map((line) => (
              <p class="flex justify-between gap-4">
                <span>{line.item}</span>
                <span>{line.amount}</span>
              </p>
            ))}
          </div>
          <img
            src="/images/receipt-rule.svg"
            alt=""
            class:list={[rule, "my-4"]}
          />
          <p class="flex justify-between text-[14px] font-semibold">
            <span>{receipt.total.label}</span>
            <span>{receipt.total.amount}</span>
          </p>
          <p class="mt-2 flex justify-between text-[11.5px] text-ink/55">
            <span>{receipt.payment.method}</span>
            <span>{receipt.payment.time}</span>
          </p>
          <img
            src="/images/receipt-rule.svg"
            alt=""
            class:list={[rule, "my-4"]}
          />
          <p class="text-center text-[10.5px] leading-[1.6] text-ink/60">
            {receipt.footer}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
